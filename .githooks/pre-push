#!/bin/sh
# Pre-push gate: typecheck, lint and unit tests (about a minute).
# Installed by `npm install` (scripts/install-hooks.mjs). Emergency skip: git push --no-verify
set -e
echo "pre-push: typecheck"; npm run -s typecheck
echo "pre-push: lint";      npm run -s lint
echo "pre-push: unit tests"; npm test --silent
