# ---------------------------------------------------------------- Core
# Any Postgres connection string (Supabase, Neon, RDS, local Docker…).
# Supabase: use the "Transaction pooler" URI (port 6543) for serverless hosts like Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/golden_tide
# Max connections per server instance (min 3 — pages run queries concurrently).
DATABASE_POOL_MAX=5
# Public base URL, used in guest links inside messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/* (sent as "Authorization: Bearer <secret>").
CRON_SECRET=

# ---------------------------------------------------------------- Auth (Auth.js)
# Required in production: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (see docs/auth.md). Leave empty to hide Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that get admin / staff access on sign-in.
ADMIN_EMAILS=
STAFF_EMAILS=

# ---------------------------------------------------------------- Payments
# Leave empty to disable online deposits (bookings then confirm instantly).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Notifications
# Each channel activates when its credentials are present. Routing, recipients
# and templates are configured in the `settings` table (key "notifications").
# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Telegram bot (great for staff groups)
TELEGRAM_BOT_TOKEN=
# SMS: "msg91" (India/DLT) or "twilio"
SMS_PROVIDER=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
