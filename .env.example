# Any Postgres connection string works (Supabase, Neon, RDS, local Docker…).
# Supabase: use the "Transaction pooler" URI (port 6543) for serverless hosts like Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/golden_tide

# Max connections per server instance (keep low on serverless).
DATABASE_POOL_MAX=5

# Public base URL, used in guest links (e.g. WhatsApp messages later).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
