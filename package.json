{
  "name": "golden-tide-retreat",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Kshitij Vengurlekar",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run -t \"\\[smoke\\]\"",
    "test:sanity": "vitest run -t \"\\[(smoke|sanity)\\]\"",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:bg": "node scripts/testing/run-bg.mjs",
    "test:report": "node scripts/testing/run-suite.mjs unit",
    "test:status": "node scripts/testing/status.mjs",
    "test:matrix": "node scripts/testing/run-suite.mjs unit >/dev/null 2>&1; node scripts/testing/matrix.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:up": "docker compose up -d db",
    "vercel-build": "node scripts/vercel-build.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "14.4.0",
    "next": "^14.2.25",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
